# Copy to .env for local development. Never commit real secrets.
PM_ENVIRONMENT=development
PM_DATABASE_URL=postgresql+asyncpg://prep:prep@localhost:5433/prepmaster
# JSON list of allowed browser origins for the web app
PM_CORS_ORIGINS=["http://localhost:3001"]

# Public URLs: the API (JazzCash posts the payment result here) and the web app
PM_API_BASE_URL=http://localhost:8000
PM_WEB_BASE_URL=http://localhost:3001

# Payments. "fake" is a local test gateway; the API refuses to start in production with it.
PM_PAYMENT_PROVIDER=fake
# For real payments set PM_PAYMENT_PROVIDER=jazzcash and fill in the merchant details:
# PM_JAZZCASH_MERCHANT_ID=
# PM_JAZZCASH_PASSWORD=
# PM_JAZZCASH_INTEGRITY_SALT=
# PM_JAZZCASH_ENDPOINT=https://sandbox.jazzcash.com.pk/CustomerPortal/transactionmanagement/merchantform/
